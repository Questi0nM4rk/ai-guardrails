{
  "name": "@questi0nm4rk/ai-guardrails",
  "version": "4.0.0",
  "type": "module",
  "files": [
    "dist/ai-guardrails",
    "dist/ai-guardrails-hk",
    "dist/ai-guardrails-hk-cc-tools",
    "scripts/install.sh",
    "scripts/build-hk-binaries.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ai-guardrails": "./dist/ai-guardrails"
  },
  "scripts": {
    "dev": "bun run --watch src/cli.ts",
    "build": "bun build src/cli.ts --compile --bytecode --production --outfile dist/ai-guardrails",
    "build:hk": "hook-kit build src/hooks.ts --out dist/ai-guardrails-hk --adapter shell",
    "build:hk-cc": "hook-kit build src/hooks.ts --out dist/ai-guardrails-hk-cc-tools --adapter cc-tools --hook-timeout 60",
    "build:all": "bun run build && bun run build:hk && bun run build:hk-cc",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^13.0.0",
    "@questi0nm4rk/hook-kit": "^0.3.0",
    "@questi0nm4rk/shell-ast": "^0.1.0",
    "minimatch": "^10.0.0",
    "smol-toml": "^1.5.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@questi0nm4rk/feats": "1.0.1",
    "@types/bun": "^1.3.10",
    "@types/minimatch": "^5.1.0",
    "typescript": "^5.8.0"
  }
}
