// Markdownlint configuration for AI Guardrails
// Single source of truth — non-pedantic, 300-column max
{
  // Default config as baseline (all rules enabled), then loosen the noisy ones
  "config": {
    "MD013": { "line_length": 300, "tables": false, "code_blocks": false, "headings": false },
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD060": false
  },

  // Ignore certain paths
  "ignores": ["node_modules/**", ".venv/**", "venv/**", "dist/**", "build/**", ".ai-guardrails/**"]
}
